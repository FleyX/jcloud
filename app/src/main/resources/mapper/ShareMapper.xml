<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fleyx.jcloud.mapper.ShareMapper">

    <select id="selectByShareCode" resultType="com.fleyx.jcloud.model.po.Share">
        SELECT *
        FROM t_share
        WHERE share_code = #{shareCode}
          AND delete_at = 0
        LIMIT 1
    </select>

</mapper>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fleyx.jcloud.mapper.RemoteSyncTaskMapper">

    <!-- 查询指定挂载点的最新同步任务 -->
    <select id="selectLatestByMountId" resultType="com.fleyx.jcloud.model.po.RemoteSyncTask">
        SELECT *
        FROM t_remote_sync_task
        WHERE remote_mount_id = #{remoteMountId}
          AND delete_at = 0
        ORDER BY create_time DESC
        LIMIT 1
    </select>

</mapper>

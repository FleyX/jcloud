<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fleyx.jcloud.mapper.UserSyncConfigMapper">

    <!-- 查询已启用且下次同步时间已到的配置列表 -->
    <select id="selectEnabledDue" resultType="com.fleyx.jcloud.model.po.UserSyncConfig">
        SELECT *
        FROM t_user_sync_config
        WHERE enabled = 1
          AND next_sync_time IS NOT NULL
          AND next_sync_time &lt;= #{now}
    </select>

</mapper>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fleyx.jcloud.mapper.UserSyncTaskMapper">

    <!-- 根据用户 ID 查询最新一条同步任务 -->
    <select id="selectLatestByUserId" resultType="com.fleyx.jcloud.model.po.UserSyncTask">
        SELECT *
        FROM t_user_sync_task
        WHERE user_id = #{userId}
          AND delete_at = 0
        ORDER BY create_time DESC
        LIMIT 1
    </select>

</mapper>

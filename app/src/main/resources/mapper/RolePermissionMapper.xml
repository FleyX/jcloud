<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fleyx.jcloud.mapper.RolePermissionMapper">

    <delete id="deleteByRoleId">
        DELETE FROM t_role_permission WHERE role_id = #{roleId}
    </delete>

    <insert id="batchInsert">
        INSERT INTO t_role_permission (id, role_id, permission_code, create_time)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.id}, #{item.roleId}, #{item.permissionCode}, #{item.createTime})
        </foreach>
    </insert>

    <select id="selectPermissionCodesByRoleId" resultType="java.lang.String">
        SELECT permission_code
        FROM t_role_permission
        WHERE role_id = #{roleId}
    </select>

    <select id="selectPermissionCodesByRoleIds" resultType="java.lang.String">
        SELECT permission_code
        FROM t_role_permission
        WHERE role_id IN
        <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
    </select>

    <select id="selectDistinctPermissionCodes" resultType="java.lang.String">
        SELECT DISTINCT permission_code
        FROM t_role_permission
    </select>
</mapper>
